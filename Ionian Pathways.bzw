# BZFlag client: saved world on Tue Aug  4 22:23:54 2009

options
  -j
  +r
  -sa
  -st 4
  -sw 1
  -a 50 38
  -ms 4
  -set _burrowAngularAd 1.1
  -set _burrowSpeedAd 1.5
  -set _countdownResumeDelay 5
  -set _explodeTime 3
  -set _jumpVelocity 19.79999
  -set _mGunAdVel 5.0
  -set _rFireAdLife .19
  -set _rFireAdVel 3
  -set _shockInRadius 1
  -set _shockOutRadius 70
  -set _shotsKeepVerticalVelocity 1
  -set _skyColor grey33
  -set _squishFactor 2
  -set _squishTime 7
  -set _syncTime 1.0
  -set _tankExplosionSize 60
  -set _tankSpeed 35
  -set _tinyFactor .3
  -set _velocityAd 2.0
  -set _wingsJumpCount 2
  -set _worldSize 1000.000000
end

world
  size 500
end

dynamicColor
  name LinkMaterial
  red limits 0 0.25
  red sinusoid 2 0 1
  green limits 0 0.25
  green sinusoid 2 0.666667 1
  blue limits 0 0.25
  blue sinusoid 2 1.33333 1
  alpha limits 0.75 0.75
end

textureMatrix
  name highwaym
  shift 1 1
end

textureMatrix
  name LinkMaterial
  shift 0 -0.05
end

material
  name highway1
  addtexture wall
    texmat highwaym
    notexalpha
end

material
  name highway2
  addtexture wall
    notexalpha
end

material
