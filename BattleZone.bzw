# BZFlag client: saved world on Tue Aug  4 14:23:33 2009

options
  -j
  +r
  -a 50 38
  -ms 5
  -set _disableBots true
  -set _laserAdRate 1
  -set _laserAdVel 10
  -set _tankSpeed 35
  -set _wingsJumpCount 3
end

dynamicColor
  name LinkMaterial
  red limits 0 0.25
  red sinusoid 2 0 1
  green limits 0 0.25
  green sinusoid 2 0.666667 1
  blue limits 0 0.25
  blue sinusoid 2 1.33333 1
  alpha limits 0.75 0.75
end

textureMatrix
  name LinkMaterial
  shift 0 -0.05
end

material
  name LinkMaterial
  dyncol LinkMaterial
  diffuse 0 0 0 0.5
  nolighting
  addtexture telelink
    texmat LinkMaterial
end

