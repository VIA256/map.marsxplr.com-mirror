# BZFlag client: saved world on Thu Jul 23 14:23:41 2009

options
  -c
  -mp 2,2,2,0,0,2
  -j
  +r
  -sa
  -st 5
  -sw 1
  -a 50 38
  -ms 3
  -set _disableBots 1
  -set _gmActivationTime 0.25
  -set _laserAdVel 8.5
  -set _shockOutRadius 40.0
  -set _wingsJumpCount 10
  -set _worldSize 370
end

world
  size 185
end

dynamicColor
  name LinkMaterial
  red limits 0 0.25
  red sinusoid 2 0 1
  green limits 0 0.25
  green sinusoid 2 0.666667 1
  blue limits 0 0.25
  blue sinusoid 2 1.33333 1
  alpha limits 0.75 0.75
end

textureMatrix
  name LinkMaterial
  shift 0 -0.05
end

material
  name LinkMaterial
  dyncol LinkMaterial
  diffuse 0 0 0 0.5
  nolighting
  addtexture telelink
    texmat LinkMaterial
end

