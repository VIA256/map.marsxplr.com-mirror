define burningdeath
  mesh
  # faces = 1
  # checks = 0
  # vertices = 4
  # normals = 0
  # texcoords = 0
  # mins = -1 -1 0
  # maxs = 1 1 0
    vertex -1.00000000 -1.00000000 0.00000000
    vertex 1.00000000 -1.00000000 0.00000000
    vertex 1.00000000 1.00000000 0.00000000
    vertex -1.00000000 1.00000000 0.00000000
    face
      vertices 0 1 2 3
      matref burningdeath
      phydrv burningdeath
    endface
  end
enddef

